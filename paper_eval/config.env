# config.env: Configuration for Sedona SpatialBench Reproduction
# Source this file before running benchmark scripts.

# --- General Settings ---
export SCALE_FACTORS=("1" "10") # Options: 0.1, 1, 10
export BENCHMARK_ENGINES="sedonadb,duckdb,spatial_polars,geopandas,clickhouse,postgis,postgis_noindex"
export QUERY_TIMEOUT="600"       # 10 minutes hard limit per query
export BENCHMARK_RUNS="3"         # Number of runs per query (reports average, stddev, and min/max)
export BENCHMARK_QUERIES="q1,q2,q3,q4,q5,q6,q7,q8,q9,q10,q11,q12"

# --- Hugging Face Dataset ---
export HF_DATASET="apache-sedona/spatialbench"
export HF_DATA_VERSION="v0.1.0"

# --- Python Environment ---
# Prefer the isolated spatialbench conda environment if available, else python3
if [ -z "${PYTHON_EXEC:-}" ]; then
    if [ -x "/local/storage/liang/.anaconda3/envs/spatialbench/bin/python" ]; then
        export PYTHON_EXEC="/local/storage/liang/.anaconda3/envs/spatialbench/bin/python"
    elif command -v python3 &> /dev/null; then
        export PYTHON_EXEC="$(which python3)"
    else
        export PYTHON_EXEC="python"
    fi
fi
export PATH="$(dirname "$PYTHON_EXEC"):$PATH"

# --- PostGIS Configuration ---
export POSTGIS_HOST="${POSTGIS_HOST:-127.0.0.1}"
export POSTGIS_PORT="${POSTGIS_PORT:-5433}"
export POSTGIS_DB="${POSTGIS_DB:-spatialbench}"
export POSTGIS_DIR="${POSTGIS_DIR:-/local/scratch/liang/postgis_db}"

# --- Data Directory Paths ---
export DATA_DIR_SF1="${DATA_DIR_SF1:-benchmark-data-sf1}"
export DATA_DIR_SF10="${DATA_DIR_SF10:-benchmark-data-sf10}"

# --- Script Compatibility Aliases ---
export DEFAULT_ENGINES="$BENCHMARK_ENGINES"
export DEFAULT_RUNS="$BENCHMARK_RUNS"
export DEFAULT_TIMEOUT="$QUERY_TIMEOUT"
export MAX_TIMEOUT="600"
export DEFAULT_QUERIES="$BENCHMARK_QUERIES"
export RESULTS_DIR="./results"
export LOGS_DIR="./logs"
export PLOTS_DIR="./plots"

# --- Engine Versions (Leave empty for latest/default) ---
export SEDONADB_VERSION="0.3.0"
export DUCKDB_VERSION="1.4.4"
export GEOPANDAS_VERSION="1.1.2"
export SPATIAL_POLARS_VERSION="0.2.3"
export APACHE_SEDONA_VERSION="1.8.1"
export CLICKHOUSE_VERSION="26.11.1"
export POSTGIS_VERSION="3.0.0"

# --- Nightly Builds (true/false) ---
export SEDONADB_NIGHTLY="false"
export DUCKDB_NIGHTLY="false"
