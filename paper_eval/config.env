# Configuration for Sedona SpatialBench Paper Reproduction (VLDB 2027)

# Python environment with spatialbench dependencies
PYTHON_EXEC="/local/storage/liang/.anaconda3/envs/spatialbench/bin/python"

# Datasets
DATA_DIR_SF1="/local/storage/liang/sedona-spatialbench/paper/benchmark-data-sf1"
DATA_DIR_SF10="/local/storage/liang/sf10"

# Target engines
DEFAULT_ENGINES="sedonadb,duckdb,spatial_polars,geopandas"

# Benchmark parameters
DEFAULT_RUNS=3
DEFAULT_TIMEOUT=300
DEFAULT_QUERIES="q1,q2,q3,q4,q5,q6,q7,q8,q9,q10,q11,q12"

# Output directories
RESULTS_DIR="./results"
LOGS_DIR="./logs"
PLOTS_DIR="./plots"
